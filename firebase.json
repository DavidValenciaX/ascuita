{
    "hosting": {
      "public": "apps/web/dist",
      "ignore": [
        "firebase.json",
        "deploy_service_account.json",
        "firebase_service_account.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    "firestore": {
      "rules": "firestore.rules"
    },
    "emulators": {
      "firestore": {
        "port": 8080
      }
    }
}

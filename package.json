{
  "name": "ascuita-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "preview:web": "npm run preview -w apps/web",
    "mobile:sync": "npm run cap:sync -w apps/web",
    "mobile:open": "npm run cap:open -w apps/web",
    "mobile:apk": "npm run cap:apk -w apps/web",
    "mobile:apk:release": "npm run cap:apk:release -w apps/web",
    "mobile:aab": "npm run cap:aab -w apps/web",
    "build": "npm run build:web && npm run build:api",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "test:rules": "firebase emulators:exec --only firestore --project ascuita-rules-test \"npm run test:rules -w apps/web\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "firebase-tools": "^14.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

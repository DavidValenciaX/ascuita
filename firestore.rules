rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users can only read/write their own data
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // Agents subcollection
      match /agents/{agentId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.personality is string
          && request.resource.data.personality.size() > 0;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.personality is string
          && request.resource.data.personality.size() > 0;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Conversations subcollection
      match /conversations/{conversationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if isOwner(uid);

        // Messages subcollection
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update, delete: if isOwner(uid);
        }
      }

      // Persistent memories
      match /memories/{memoryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && memoryId.matches('^memory-[0-9a-f]{8}-[0-9a-f]{8}$')
          && request.resource.data.keys().hasOnly([
            'content',
            'category',
            'createdAt',
            'updatedAt',
            'sourceAgentId'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.category in [
            'preference',
            'personal_fact',
            'goal',
            'context'
          ]
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (!('sourceAgentId' in request.resource.data)
            || (
              request.resource.data.sourceAgentId is string
              && request.resource.data.sourceAgentId.size() <= 128
            ));
        allow update: if isOwner(uid)
          && memoryId.matches('^memory-[0-9a-f]{8}-[0-9a-f]{8}$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content',
            'category',
            'updatedAt',
            'sourceAgentId'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.category in [
            'preference',
            'personal_fact',
            'goal',
            'context'
          ]
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && (!('sourceAgentId' in request.resource.data)
            || (
              request.resource.data.sourceAgentId is string
              && request.resource.data.sourceAgentId.size() <= 128
            ));
        allow delete: if isOwner(uid);
      }

    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

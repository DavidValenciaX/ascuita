HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=https://ascuita.web.app,https://localhost
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Firebase Admin puede usar estas credenciales locales o las credenciales
# nativas de Google Cloud cuando el backend corre en Cloud Run.
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@replace-me.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
SECURITY_LOG_DIR=logs/security

HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=https://ascuita.web.app,https://localhost
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Firebase Admin usa GOOGLE_APPLICATION_CREDENTIALS en local y las
# credenciales nativas de Google Cloud cuando el backend corre en Cloud Run.
FIREBASE_PROJECT_ID=replace_me
GOOGLE_APPLICATION_CREDENTIALS=path_to_firebase_service_account.json

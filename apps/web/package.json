{
  "name": "@ascuita/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "node scripts/validate-mobile-env.mjs && vite build --mode mobile",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open": "cap open android",
    "cap:apk": "npm run cap:sync && node scripts/run-gradle.mjs assembleDebug",
    "cap:apk:release": "npm run cap:sync && node scripts/validate-release-signing.mjs && node scripts/run-gradle.mjs assembleRelease",
    "cap:aab": "npm run cap:sync && node scripts/validate-release-signing.mjs && node scripts/run-gradle.mjs bundleRelease",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^1.29.1",
    "classnames": "^2.5.1",
    "eventemitter3": "^5.0.1",
    "firebase": "^12.14.0",
    "lodash": "^4.17.21",
    "path": "^0.12.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "three": "^0.184.0",
    "vite": "^6.3.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "jsdom": "^25.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.0"
  }
}
